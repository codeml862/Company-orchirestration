# Backend settings. Copy to backend/.env and adjust; every variable is optional in development.
# All names use the AICO_ prefix (see app/config.py).

AICO_ENV=development
# SQLite file for local development, or PostgreSQL: postgresql+psycopg://aico:aico@localhost:5432/aico
AICO_DATABASE_URL=sqlite:///./data/aico.db

# Auth. AICO_JWT_SECRET is required in production (at least 16 characters).
AICO_JWT_SECRET=change-me-in-production
AICO_ACCESS_TOKEN_MINUTES=720

# "Continue with Google" on the login page. Create an OAuth client ID (type: Web application) in the
# Google Cloud console and add the web app's origin (e.g. http://localhost:3000) to its Authorized
# JavaScript origins. Google sign-in only works for users that already exist with the same email.
AICO_GOOGLE_CLIENT_ID=

# Self-service "Create account": anyone can register a client company (never a staff account).
# New clients start on local models only. Set to false to make accounts invite-only.
AICO_ALLOW_SIGNUP=true

# First admin, created by `python -m app.cli bootstrap` when no admin exists.
AICO_BOOTSTRAP_ADMIN_EMAIL=admin@orchestria.local
AICO_BOOTSTRAP_ADMIN_PASSWORD=admin-change-me

# Departments to load (empty: all). Run `uv run python -m app.cli sync-catalog` after changing it.
# The workflow needs executive (CEO) and operations (planning + QA) plus at least one delivery department.
# All keys: executive,operations,technology,hr,marketing,sales,finance,support,research
AICO_ENABLED_DEPARTMENTS=

# Orchestration engine
AICO_WORKER_CONCURRENCY=4
AICO_WORKER_POLL_SECONDS=1.0
AICO_TASK_LEASE_SECONDS=600
AICO_MAX_PLAN_TASKS=40
AICO_MAX_DELEGATION_DEPTH=3

# LLM providers: a JSON list of OpenAI-compatible endpoints, tried in order (see app/providers/router.py).
# Workers do not claim tasks while this is empty. Keys can be referenced by env var name with api_key_env.
# "external": false marks a local provider, the only kind used for clients that do not allow external LLMs.
# Example:
# AICO_LLM_PROVIDERS=[{"name": "ollama", "base_url": "http://localhost:11434/v1", "external": false, "models": {"strong": "qwen3:14b", "standard": "qwen3:8b", "fast": "qwen3:4b"}}, {"name": "groq", "base_url": "https://api.groq.com/openai/v1", "api_key_env": "GROQ_API_KEY", "models": {"strong": "openai/gpt-oss-120b", "standard": "openai/gpt-oss-20b"}}]
AICO_LLM_PROVIDERS=[]
# GROQ_API_KEY=

# Storage for uploads and deliverables
AICO_STORAGE_DIR=./data/storage
AICO_MAX_UPLOAD_MB=25
# Readable project folders (code in its file structure + PROJECT_LOG.md), refreshed as tasks finish
AICO_WORKSPACE_DIR=./data/workspaces

# Sandboxed code execution for agents: "docker" (isolated, required in production) or "subprocess"
# (development only, Linux/macOS: it uses POSIX resource limits and does not work on native Windows).
AICO_SANDBOX_BACKEND=docker
AICO_SANDBOX_IMAGE=python:3.12-slim
AICO_SANDBOX_TIMEOUT_SECONDS=60
AICO_SANDBOX_MEMORY_MB=512

# Comma-separated origins allowed to call the API from a browser
AICO_CORS_ORIGINS=http://localhost:3000
